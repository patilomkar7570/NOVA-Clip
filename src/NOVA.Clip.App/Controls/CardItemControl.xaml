<UserControl x:Class="NOVA.Clip.App.Controls.CardItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:NOVA.Clip.Core.Models;assembly=NOVA.Clip.Core"
             mc:Ignorable="d"
             d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,0,0,8"
            Padding="12,10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag Handle & Type Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,10,0">
                <!-- Drag Handle -->
                <Border x:Name="DragHandle"
                        Cursor="SizeAll"
                        Background="Transparent"
                        Padding="2"
                        Margin="0,0,6,0"
                        ToolTip="Drag into any application"
                        PreviewMouseDown="DragHandle_PreviewMouseDown"
                        PreviewMouseMove="DragHandle_PreviewMouseMove">
                    <Path Data="{StaticResource IconDragHandle}"
                          Stroke="{DynamicResource BrushTextMuted}"
                          StrokeThickness="1.5"
                          Width="12" Height="14"
                          Stretch="Uniform" />
                </Border>

                <!-- Type Icon Badge -->
                <Border Width="28" Height="28" CornerRadius="6"
                        Background="{DynamicResource BrushSurfaceActive}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="TypeIconPath"
                          Data="{StaticResource IconText}"
                          Stroke="{DynamicResource BrushAccent}"
                          StrokeThickness="1.5"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Border>
            </StackPanel>

            <!-- Content Area -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- Title -->
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />

                <!-- Preview text -->
                <TextBlock Text="{Binding PreviewText}"
                           FontSize="12"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="36"
                           TextWrapping="Wrap"
                           Margin="0,2,0,4" />

                <!-- Metadata Row -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SourceApplication}"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}"
                               FontWeight="Medium"
                               Margin="0,0,6,0" />

                    <TextBlock Text="•"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,0,6,0" />

                    <TextBlock Text="{Binding FriendlyTime}"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Margin="0,0,6,0" />

                    <TextBlock Text="{Binding SecondaryInfo}"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextMuted}"
                               Visibility="{Binding SecondaryInfo, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>

            <!-- Actions Row -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Favorite Toggle -->
                <Button Command="{Binding ToggleFavoriteCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Cursor="Hand"
                        ToolTip="Favorite">
                    <Path x:Name="FavoriteStarPath"
                          Data="{StaticResource IconStar}"
                          Stroke="{DynamicResource BrushTextMuted}"
                          Fill="Transparent"
                          StrokeThickness="1.5"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>

                <!-- Copy Button -->
                <Button Command="{Binding CopyCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Cursor="Hand"
                        ToolTip="Copy to Clipboard">
                    <Path Data="{StaticResource IconCopy}"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.5"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>

                <!-- Add to Queue -->
                <Button Command="{Binding AddToQueueCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Cursor="Hand"
                        ToolTip="Add to Paste Queue">
                    <Path Data="{StaticResource IconQueue}"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.5"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Button>

                <!-- Details Button -->
                <Button Command="{Binding ViewDetailsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Cursor="Hand"
                        ToolTip="Details">
                    <Path Data="{StaticResource IconExternalLink}"
                          Stroke="{DynamicResource BrushTextMuted}"
                          StrokeThickness="1.5"
                          Width="13" Height="13"
                          Stretch="Uniform" />
                </Button>

                <!-- Delete Button -->
                <Button Command="{Binding DeleteCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        Cursor="Hand"
                        ToolTip="Delete">
                    <Path Data="{StaticResource IconTrash}"
                          Stroke="{DynamicResource BrushDanger}"
                          StrokeThickness="1.5"
                          Width="13" Height="13"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
