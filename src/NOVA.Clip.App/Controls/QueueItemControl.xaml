<UserControl x:Class="NOVA.Clip.App.Controls.QueueItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="400">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,0,0,6"
            Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Order Index Badge & Completed Check -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Border Width="24" Height="24" CornerRadius="12"
                        Background="{DynamicResource BrushSurfaceActive}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="OrderIndexText"
                               Text="{Binding OrderIndex}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Check icon when completed -->
                <Path x:Name="CompletedCheckPath"
                      Data="{StaticResource IconCheck}"
                      Stroke="{DynamicResource BrushSuccess}"
                      StrokeThickness="2"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      Margin="6,0,0,0"
                      Visibility="Collapsed" />
            </StackPanel>

            <!-- Text Preview -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />

                <TextBlock Text="{Binding PreviewText}"
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </StackPanel>

            <!-- Up / Down / Remove Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MoveUpBtn"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Cursor="Hand"
                        ToolTip="Move Up">
                    <Path Data="{StaticResource IconArrowUp}"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.5"
                          Width="12" Height="12"
                          Stretch="Uniform" />
                </Button>

                <Button x:Name="MoveDownBtn"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Cursor="Hand"
                        ToolTip="Move Down">
                    <Path Data="{StaticResource IconArrowDown}"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.5"
                          Width="12" Height="12"
                          Stretch="Uniform" />
                </Button>

                <Button x:Name="RemoveBtn"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Cursor="Hand"
                        ToolTip="Remove from Queue">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="{DynamicResource BrushDanger}"
                          StrokeThickness="1.5"
                          Width="12" Height="12"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
