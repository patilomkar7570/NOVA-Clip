<Window x:Class="NOVA.Clip.App.Views.FloatingPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NOVA.Clip.App.ViewModels"
        Title="NOVA Clip - Top Island"
        Icon="pack://application:,,,/Resources/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Height="68"
        MaxHeight="70"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Top Screen Dynamic Island Capsule -->
    <Border Background="#121316"
            BorderBrush="#2C2F3A"
            BorderThickness="1"
            CornerRadius="16"
            Padding="6,4"
            MouseLeftButtonDown="Island_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- Brand Logo Pill -->
                <ColumnDefinition Width="Auto" />  <!-- Phone Sync Pill Button -->
                <ColumnDefinition Width="*" />     <!-- 4 Boxes -->
                <ColumnDefinition Width="Auto" />  <!-- Action Buttons -->
            </Grid.ColumnDefinitions>

            <!-- 1. Left Brand Squircle -->
            <Button Grid.Column="0"
                    Command="{Binding OpenFullAppCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="4,0,6,0"
                    Cursor="Hand"
                    ToolTip="NOVA Clip Island (Click to open full dashboard)">
                <Border Width="28" Height="28" CornerRadius="8" Background="#FFFFFF">
                    <Image Source="pack://application:,,,/Resources/logo.png"
                           Width="18" Height="18"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Button>

            <!-- 2. Phone Sync Pill -->
            <Button Grid.Column="1"
                    Command="{Binding OpenPhoneSyncCommand}"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Padding="6,3"
                    Margin="0,0,6,0"
                    Cursor="Hand"
                    ToolTip="{Binding PhoneSyncHint}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📱" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Phone Sync" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 3. Center: The 4 Boxes -->
            <ItemsControl Grid.Column="2" ItemsSource="{Binding RecentSlots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ItemCardViewModel}">
                        <!-- Box Container -->
                        <Border x:Name="BoxBorder"
                                CornerRadius="10"
                                Background="#1A1C23"
                                BorderBrush="#2C2F3C"
                                BorderThickness="1"
                                Margin="3,0"
                                Padding="8,4"
                                Height="56"
                                Cursor="Hand"
                                ToolTip="{Binding Title}"
                                PreviewMouseDown="Slot_PreviewMouseDown"
                                PreviewMouseMove="Slot_PreviewMouseMove"
                                MouseLeftButtonUp="Slot_MouseLeftButtonUp">
                            <Border.ContextMenu>
                                <ContextMenu Background="#1E293B" BorderBrush="#334155" Foreground="White">
                                    <MenuItem Header="📱 Send to iPhone" Command="{Binding SendToPhoneCommand}" />
                                    <MenuItem Header="📋 Copy to Clipboard" Command="{Binding CopyCommand}" />
                                    <MenuItem Header="⭐ Star / Favorite" Command="{Binding ToggleFavoriteCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#252834" />
                                            <Setter Property="BorderBrush" Value="#3B82F6" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsEmptySlot}" Value="True">
                                            <Setter Property="Background" Value="#131418" />
                                            <Setter Property="BorderBrush" Value="#202229" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <!-- State A: Normal Populated Slot -->
                                <Grid x:Name="PopulatedSlotGrid">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmptySlot}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Type Icon Pill -->
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="6"
                                            Background="#232632"
                                            VerticalAlignment="Center"
                                            Margin="0,0,7,0">
                                        <Path Data="{Binding TypeIconGeometry}"
                                              Stroke="{Binding TypeBrush}"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              StrokeThickness="1.5" />
                                    </Border>

                                    <!-- Content Texts -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,1,0,0">
                                        <!-- Top row: Category tag & slot number -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       FontSize="8.5"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding TypeBrush}" />
                                            <TextBlock Text="{Binding SlotNumber, StringFormat=' #{0}'}"
                                                       FontSize="8"
                                                       Foreground="#64748B"
                                                       Margin="2,0,0,0" />
                                        </StackPanel>

                                        <!-- Title / Preview / Link / Filename (Crisp White) -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />

                                        <!-- Secondary info / domain / size -->
                                        <TextBlock Text="{Binding SecondaryInfo}"
                                                   FontSize="9"
                                                   Foreground="#CBD5E1"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>

                                <!-- State B: Empty Slot Placeholder -->
                                <Grid x:Name="EmptySlotGrid">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmptySlot}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SlotNumber, StringFormat='Slot {0}'}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#475569"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Empty"
                                                   FontSize="8.5"
                                                   Foreground="#334155"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Copied Feedback Toast Overlay -->
                                <Border Background="#10B981"
                                        CornerRadius="8"
                                        Padding="6,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" />
                                        <TextBlock Text="Copied!" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 4. Right Action Buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,2,0">
                <Button Command="{Binding OpenFullAppCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="5"
                        Cursor="Hand"
                        ToolTip="Open Full Application">
                    <Path Data="{StaticResource IconOverview}" Stroke="#94A3B8" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                </Button>
                <Button Click="CloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="5"
                        Cursor="Hand"
                        ToolTip="Close (Esc)">
                    <Path Data="{StaticResource IconClose}" Stroke="#64748B" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
