<Window x:Class="NOVA.Clip.App.Views.ItemDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item Details - NOVA Clip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Width="500" Height="520">

    <Border Background="{DynamicResource BrushAppBackground}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ItemTitleText" Text="Item Title" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ItemMetaText" Text="Type • Timestamp" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Metadata Box -->
                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source App:" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="0,0,10,4" />
                            <TextBlock x:Name="SourceAppText" Grid.Row="0" Grid.Column="1" Text="notepad.exe" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Window Title:" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="0,0,10,4" />
                            <TextBlock x:Name="WindowTitleText" Grid.Row="1" Grid.Column="1" Text="Untitled" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Created:" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="0,0,10,4" />
                            <TextBlock x:Name="CreatedText" Grid.Row="2" Grid.Column="1" Text="2026-11-10 12:00:00" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Payload Size:" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="0,0,10,0" />
                            <TextBlock x:Name="SizeText" Grid.Row="3" Grid.Column="1" Text="120 B" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- Raw Content Text Box -->
                    <TextBlock Text="Content Preview:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10" MinHeight="160">
                        <TextBox x:Name="RawContentTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 FontFamily="Consolas, Segoe UI"
                                 FontSize="12" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CopyBtn" Click="CopyButton_Click" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCopy}" Stroke="White" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Copy Content" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Click="CloseButton_Click" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrushTextPrimary}" Padding="14,6" Cursor="Hand">
                    <TextBlock Text="Close" FontWeight="Medium" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
