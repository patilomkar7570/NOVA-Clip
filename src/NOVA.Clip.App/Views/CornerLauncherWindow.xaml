<Window x:Class="NOVA.Clip.App.Views.CornerLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA Clip Launcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="48" Height="48"
        ResizeMode="NoResize">

    <Border x:Name="LauncherBorder"
            Width="44" Height="44"
            CornerRadius="22"
            Background="{DynamicResource BrushAccent}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1.5"
            Cursor="Hand"
            ToolTip="NOVA Clip (Click to open floating clipboard)"
            MouseLeftButtonDown="LauncherBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <Path Data="{StaticResource IconClipboard}"
              Stroke="White"
              StrokeThickness="2"
              Width="20" Height="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Stretch="Uniform" />
    </Border>
</Window>
