<Window x:Class="NOVA.Clip.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NOVA.Clip.App.ViewModels"
        xmlns:controls="clr-namespace:NOVA.Clip.App.Controls"
        mc:Ignorable="d"
        Title="NOVA Clip - Clipboard Manager"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="700" Width="1060"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushAppBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Base Rounded Button Style -->
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceActive}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Button Style -->
        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" />   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- 1. SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSidebarBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Brand Logo -->
                    <RowDefinition Height="*" />    <!-- Navigation Items -->
                    <RowDefinition Height="Auto" /> <!-- Footer Profile / Version -->
                </Grid.RowDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,20">
                    <Border Width="30" Height="30" CornerRadius="7" Background="#FFFFFF" Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/Resources/logo.png" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NOVA" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text=" Clip" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource BrushAccent}" />
                        </StackPanel>
                        <TextBlock Text="v1.0 • Desktop" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Overview -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Overview">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconOverview}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Overview" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- All Items -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="All Items">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClipboard}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="All Items" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Favorites -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Favorites">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStar}" Stroke="{DynamicResource BrushFavorite}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Favorites" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,8" />

                        <!-- Section: Formats -->
                        <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="12,4,0,6" />

                        <!-- Text -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Text">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconText}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Text" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Links -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Links">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconLink}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Links" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Images -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Images">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconImage}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Images" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Files -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Files">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFiles}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Files" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BrushBorderSubtle}" Margin="0,8" />

                        <!-- Section: Tools -->
                        <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="12,4,0,6" />

                        <!-- Snippets -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Snippets">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSnippet}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Snippets" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Paste Queues -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Paste Queues">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconQueue}" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Paste Queues" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <!-- Status indicator dot -->
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoringActive}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource BrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Monitoring Active" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoringActive}" Value="False">
                                                <Setter Property="Text" Value="Monitoring Paused" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Quick Floating panel shortcut button -->
                        <Button Command="{Binding TriggerFloatingPanelCommand}" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="6,4" Cursor="Hand">
                            <TextBlock Text="Open Quick Panel" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
                <RowDefinition Height="*" />    <!-- Dynamic View Content -->
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Section Title & Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveSection}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushTextPrimary}" />
                    </StackPanel>

                    <!-- Header Shortcut Badge & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushSurfaceActive}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="Floating Shortcut: Ctrl + Shift + Space" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Host -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="20,16">
                <ContentControl.Resources>
                    <!-- Template for Overview -->
                    <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Welcome Hero Banner with Official Logo -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Image Source="pack://application:,,,/Resources/logo.png" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Welcome to NOVA Clip" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Everything you copy. Always within reach." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Command="{Binding OpenFloatingPanelCommand}" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="14,8" VerticalAlignment="Center" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Resources/logo-white.png" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="Open Quick Panel" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Stats Cards Grid -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Card 1: Total Saved -->
                                    <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Total Saved" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding TotalItemsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Formats breakdown -->
                                    <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Content Types" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding TextCount}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" />
                                                <TextBlock Text=" txt • " FontSize="12" Foreground="{DynamicResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding LinkCount}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" />
                                                <TextBlock Text=" url • " FontSize="12" Foreground="{DynamicResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding ImageCount}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" />
                                                <TextBlock Text=" img" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Storage Used -->
                                    <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Local Storage" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding StorageUsedFormatted}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Quick Actions -->
                                    <Border Grid.Column="3" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Quick Actions" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Command="{Binding ToggleMonitoringCommand}" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                                                    <TextBlock Text="Pause/Resume" FontSize="11" />
                                                </Button>
                                                <Button Command="{Binding ClearHistoryCommand}" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushDanger}" BorderThickness="0" Padding="8,4" Cursor="Hand">
                                                    <TextBlock Text="Clear" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Recent Items Header -->
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Recent Clipboard Entries" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand" ToolTip="Refresh">
                                        <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </Grid>

                                <!-- Recent Items List -->
                                <ItemsControl ItemsSource="{Binding RecentItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CardItemControl />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Favorites Header -->
                                <TextBlock Text="Favorites" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,10" />
                                <ItemsControl ItemsSource="{Binding FavoriteItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CardItemControl />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>

                    <!-- Template for ClipboardListViewModel (All, Text, Links, Images, Files, Favorites) -->
                    <DataTemplate DataType="{x:Type vm:ClipboardListViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Search and Controls -->
                                <RowDefinition Height="*" />    <!-- List -->
                            </Grid.RowDefinitions>

                            <!-- Search bar & Bulk actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Search Field -->
                                <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Bulk Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding ToggleBulkSelectModeCommand}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrushTextSecondary}" Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                        <TextBlock Text="Select" FontSize="12" />
                                    </Button>
                                    <Button Command="{Binding DeleteSelectedCommand}" Visibility="{Binding IsBulkSelectMode, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushDanger}" Foreground="White" BorderThickness="0" Padding="10,6" Cursor="Hand">
                                        <TextBlock Text="Delete Selected" FontSize="12" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Items List -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Items}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <controls:CardItemControl />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DataTemplate>

                    <!-- Template for SnippetsViewModel -->
                    <DataTemplate DataType="{x:Type vm:SnippetsViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" /> <!-- List -->
                                <ColumnDefinition Width="*" />   <!-- Editor/Preview -->
                            </Grid.ColumnDefinitions>

                            <!-- Left: Snippets List -->
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Search and New Button -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,0">
                                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" />
                                        </Border>

                                        <Button Grid.Column="1" Command="{Binding StartNewSnippetCommand}" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="10,6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="New" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Snippet Items -->
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Snippets}" SelectedItem="{Binding SelectedSnippet, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        <TextBlock Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Tags}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Editor -->
                            <Border Grid.Column="1" Padding="16,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Snippet Editor" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />

                                    <TextBlock Text="Title" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,6" Margin="0,0,0,12" />

                                    <TextBlock Text="Content" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditorContent, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas, Segoe UI" AcceptsReturn="True" TextWrapping="Wrap" Height="180" Padding="8,6" Margin="0,0,0,12" />

                                    <TextBlock Text="Tags (comma-separated)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditorTags, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,6" Margin="0,0,0,16" />

                                    <!-- Save Actions -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding SaveSnippetCommand}" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Cursor="Hand">
                                            <TextBlock Text="Save Snippet" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Command="{Binding CancelEditCommand}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrushTextPrimary}" Padding="16,8" Cursor="Hand">
                                            <TextBlock Text="Cancel" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>

                    <!-- Template for PasteQueueViewModel -->
                    <DataTemplate DataType="{x:Type vm:PasteQueueViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Queue Header Controls -->
                                <RowDefinition Height="*" />    <!-- Ordered Items -->
                                <RowDefinition Height="Auto" /> <!-- Queue Operations Bar -->
                            </Grid.RowDefinitions>

                            <!-- Queue Header Controls -->
                            <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Queue Selector and Info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding AvailableQueues}" SelectedItem="{Binding ActiveQueue}" DisplayMemberPath="Name" Width="180" Margin="0,0,10,0" />
                                        <Button Command="{Binding CreateNewQueueCommand}" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" Padding="8,4" Margin="0,0,6,0" Cursor="Hand">
                                            <TextBlock Text="+ New Queue" FontSize="11" />
                                        </Button>
                                        <Button Command="{Binding DeleteQueueCommand}" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushDanger}" BorderThickness="0" Padding="8,4" Cursor="Hand">
                                            <TextBlock Text="Delete Queue" FontSize="11" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Separator Choice -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Separator:" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <ComboBox SelectedValue="{Binding SelectedSeparator}" SelectedValuePath="Tag" Width="130">
                                            <ComboBoxItem Content="New Line (\n)" Tag="\n" IsSelected="True" />
                                            <ComboBoxItem Content="Double Line (\n\n)" Tag="\n\n" />
                                            <ComboBoxItem Content="Comma (, )" Tag=", " />
                                            <ComboBoxItem Content="Tab (\t)" Tag="\t" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Ordered Items List -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding QueueItems}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <controls:QueueItemControl />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Queue Operations Bar (Copy Next, Paste Next, Paste All) -->
                            <Border Grid.Row="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Message -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusFeedback}" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource BrushAccent}" />
                                        <TextBlock Text="{Binding PasteAllWarning}" FontSize="11" Foreground="{DynamicResource BrushWarning}" Visibility="{Binding PasteAllWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Reset -->
                                        <Button Command="{Binding ResetPositionCommand}" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" Padding="12,7" Margin="0,0,8,0" Cursor="Hand">
                                            <TextBlock Text="Reset" FontSize="12" />
                                        </Button>

                                        <!-- Copy Next -->
                                        <Button Command="{Binding CopyNextCommand}" Background="{DynamicResource BrushSurfaceActive}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" Foreground="{DynamicResource BrushAccent}" Padding="14,7" Margin="0,0,8,0" Cursor="Hand">
                                            <TextBlock Text="Copy Next" FontWeight="SemiBold" FontSize="12" />
                                        </Button>

                                        <!-- Paste Next -->
                                        <Button Click="PasteNextButton_Click" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="16,7" Margin="0,0,8,0" Cursor="Hand">
                                            <TextBlock Text="Paste Next" FontWeight="Bold" FontSize="12" />
                                        </Button>

                                        <!-- Paste All -->
                                        <Button Click="PasteAllButton_Click" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" Padding="14,7" Cursor="Hand">
                                            <TextBlock Text="Paste All" FontWeight="SemiBold" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>

                    <!-- Template for SettingsViewModel -->
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                                <!-- Group 1: General & Appearance -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="General &amp; Appearance" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />

                                        <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start NOVA Clip with Windows" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Minimize to system tray" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="{Binding CloseToTray}" Content="Closing window minimizes to tray" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />

                                        <TextBlock Text="Theme" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding ThemeMode}" SelectedValuePath="Tag" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <ComboBoxItem Content="Follow Windows (System)" Tag="System" />
                                            <ComboBoxItem Content="Dark Mode" Tag="Dark" />
                                            <ComboBoxItem Content="Light Mode" Tag="Light" />
                                        </ComboBox>

                                        <CheckBox IsChecked="{Binding CornerLauncherEnabled}" Content="Enable Screen Corner Quick Launcher" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                                        <ComboBox SelectedValue="{Binding CornerLauncherPosition}" SelectedValuePath="Tag" Width="180" HorizontalAlignment="Left" Visibility="{Binding CornerLauncherEnabled, Converter={StaticResource BoolToVis}}">
                                            <ComboBoxItem Content="Bottom Right" Tag="BottomRight" />
                                            <ComboBoxItem Content="Bottom Left" Tag="BottomLeft" />
                                            <ComboBoxItem Content="Top Right" Tag="TopRight" />
                                            <ComboBoxItem Content="Top Left" Tag="TopLeft" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Group 2: Clipboard & Privacy -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Clipboard &amp; Privacy" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />

                                        <CheckBox IsChecked="{Binding MonitoringEnabled}" Content="Enable clipboard monitoring" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="{Binding DuplicateDetectionEnabled}" Content="Enable duplicate detection (updates timestamp rather than duplicating)" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="{Binding SensitiveContentProtectionEnabled}" Content="Enable sensitive content protection (passwords, OTPs, credit cards)" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />

                                        <TextBlock Text="Excluded Applications (Never capture from these processes):" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding ExcludedProcesses}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BrushSurfaceActive}" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                                        <Grid>
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                            <Button Command="{Binding DataContext.RemoveExcludedProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                                <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource BrushDanger}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add Excluded Process -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBox Text="{Binding NewExcludedProcess, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="6,4" Background="{DynamicResource BrushSurfaceActive}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" />
                                            <Button Command="{Binding AddExcludedProcessCommand}" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="10,4" Cursor="Hand">
                                                <TextBlock Text="Add Excluded App" FontSize="11" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Retention Settings -->
                                        <TextBlock Text="History Retention Period:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding RetentionDays}" SelectedValuePath="Tag" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <ComboBoxItem Content="7 Days" Tag="7" />
                                            <ComboBoxItem Content="30 Days" Tag="30" />
                                            <ComboBoxItem Content="90 Days" Tag="90" />
                                            <ComboBoxItem Content="Never Automatically Expire" Tag="0" />
                                        </ComboBox>

                                        <!-- Clear Data Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Command="{Binding ClearAllHistoryCommand}" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushDanger}" BorderThickness="0" Padding="10,6" Margin="0,0,8,0" Cursor="Hand">
                                                <TextBlock Text="Clear All History" FontSize="11" />
                                            </Button>
                                            <Button Command="{Binding ClearImagesCommand}" Background="{DynamicResource BrushSurfaceActive}" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" Padding="10,6" Cursor="Hand">
                                                <TextBlock Text="Clear Saved Images" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Group 3: About NOVA Clip -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Background="#FFFFFF" Margin="0,0,16,0" VerticalAlignment="Top">
                                            <Image Source="pack://application:,,,/Resources/logo.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="About NOVA Clip" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                            <TextBlock Text="Everything you copy. Always within reach." FontSize="13" Foreground="{DynamicResource BrushAccent}" FontWeight="Medium" Margin="0,0,0,4" />
                                            <TextBlock Text="Version 1.0.0 — Windows Desktop Edition" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                            <TextBlock Text="Protected with Windows DPAPI (Data Protection API) CurrentUser encryption." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                            <TextBlock Text="100% Offline • Zero Telemetry • Local SQLite Database." FontSize="11" Foreground="{DynamicResource BrushSuccess}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Save Settings Button -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Button Command="{Binding SaveSettingsCommand}" Background="{DynamicResource BrushAccent}" Foreground="White" BorderThickness="0" Padding="20,10" Cursor="Hand">
                                        <TextBlock Text="Save Settings" FontWeight="Bold" FontSize="13" />
                                    </Button>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
